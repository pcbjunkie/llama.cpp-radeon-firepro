#version 450

// local: fused MUL_MAT_ID(gate) + MUL_MAT_ID(up) + SWIGLU for Q4_K experts.
// One workgroup computes the same rows of the gate and up matrices for one expert slot,
// sharing the activation loads, and writes silu(gate) * up.
// Built only with MUL_MAT_ID and USE_SUBGROUP_ADD_NO_SHMEM (workgroup == one subgroup).

#extension GL_EXT_shader_explicit_arithmetic_types_int32 : require

#include "mul_mat_vec_base.glsl"

layout(local_size_x_id = 0, local_size_y = 1, local_size_z = 1) in;

layout (binding = 6) readonly buffer A2 {A_TYPE data_a2[];};
layout (binding = 6) readonly buffer A2_PACKED16 {A_TYPE_PACKED16 data_a2_packed16[];};
layout (binding = 6) readonly buffer A2_PACKED32 {A_TYPE_PACKED32 data_a2_packed32[];};

FLOAT_TYPE temp_g[NUM_ROWS];
FLOAT_TYPE temp_u[NUM_ROWS];

// Q4_K superblock contribution, given the raw words of one block and four activation vectors.
FLOAT_TYPE q4k_dot(const FLOAT_TYPEV2 dm, const uint32_t scale0_u32, const uint32_t scale4_u32, const uint32_t scale8_u32,
                   const uint32_t qs0_u32, const uint32_t qs64_u32,
                   const vec4 by10, const vec4 by132, const vec4 by20, const vec4 by232) {
    const uint32_t scale_0_4_l = (scale4_u32 << 16) | scale0_u32;
    const uint32_t scale_0_4_h = (scale_0_4_l & 0xC0C0C0C0) >> 2;
    const vec4 scale_0_4_l_f = vec4(unpack8(scale_0_4_l & 0x3F3F3F3F));
    const vec4 scale8_f = vec4(unpack8((((scale8_u32 << 12) | scale8_u32) & 0x0F0F0F0F) | scale_0_4_h));

    const FLOAT_TYPE sc0 = scale_0_4_l_f.x;
    const FLOAT_TYPE sc1 = scale_0_4_l_f.y;
    const FLOAT_TYPE sc2 = scale_0_4_l_f.z;
    const FLOAT_TYPE sc3 = scale_0_4_l_f.w;
    const FLOAT_TYPE sc4 = scale8_f.x;
    const FLOAT_TYPE sc5 = scale8_f.y;
    const FLOAT_TYPE sc6 = scale8_f.z;
    const FLOAT_TYPE sc7 = scale8_f.w;

    const vec4 qs0_lo4  = vec4(unpack8(qs0_u32 & 0x0F0F0F0F));
    const vec4 qs64_lo4 = vec4(unpack8(qs64_u32 & 0x0F0F0F0F));
    const vec4 qs0_hi4  = vec4(unpack8((qs0_u32 >> 4) & 0x0F0F0F0F));
    const vec4 qs64_hi4 = vec4(unpack8((qs64_u32 >> 4) & 0x0F0F0F0F));

    const FLOAT_TYPE sx = fma(FLOAT_TYPE(by10.x),  FLOAT_TYPE(qs0_lo4.x),  fma(FLOAT_TYPE(by10.y),  FLOAT_TYPE(qs0_lo4.y),  fma(FLOAT_TYPE(by10.z),  FLOAT_TYPE(qs0_lo4.z),  FLOAT_TYPE(by10.w)  * FLOAT_TYPE(qs0_lo4.w))));
    const FLOAT_TYPE sy = fma(FLOAT_TYPE(by132.x), FLOAT_TYPE(qs0_hi4.x),  fma(FLOAT_TYPE(by132.y), FLOAT_TYPE(qs0_hi4.y),  fma(FLOAT_TYPE(by132.z), FLOAT_TYPE(qs0_hi4.z),  FLOAT_TYPE(by132.w) * FLOAT_TYPE(qs0_hi4.w))));
    const FLOAT_TYPE sz = fma(FLOAT_TYPE(by20.x),  FLOAT_TYPE(qs64_lo4.x), fma(FLOAT_TYPE(by20.y),  FLOAT_TYPE(qs64_lo4.y), fma(FLOAT_TYPE(by20.z),  FLOAT_TYPE(qs64_lo4.z), FLOAT_TYPE(by20.w)  * FLOAT_TYPE(qs64_lo4.w))));
    const FLOAT_TYPE sw = fma(FLOAT_TYPE(by232.x), FLOAT_TYPE(qs64_hi4.x), fma(FLOAT_TYPE(by232.y), FLOAT_TYPE(qs64_hi4.y), fma(FLOAT_TYPE(by232.z), FLOAT_TYPE(qs64_hi4.z), FLOAT_TYPE(by232.w) * FLOAT_TYPE(qs64_hi4.w))));
    const FLOAT_TYPE smin =
        fma(FLOAT_TYPE(by10.x), sc2, fma(FLOAT_TYPE(by132.x), sc3, fma(FLOAT_TYPE(by20.x), sc6, fma(FLOAT_TYPE(by232.x), sc7,
        fma(FLOAT_TYPE(by10.y), sc2, fma(FLOAT_TYPE(by132.y), sc3, fma(FLOAT_TYPE(by20.y), sc6, fma(FLOAT_TYPE(by232.y), sc7,
        fma(FLOAT_TYPE(by10.z), sc2, fma(FLOAT_TYPE(by132.z), sc3, fma(FLOAT_TYPE(by20.z), sc6, fma(FLOAT_TYPE(by232.z), sc7,
        fma(FLOAT_TYPE(by10.w), sc2, fma(FLOAT_TYPE(by132.w), sc3, fma(FLOAT_TYPE(by20.w), sc6,     FLOAT_TYPE(by232.w) * sc7)))))))))))))));
    return fma(dm.x, fma(sx, sc0, fma(sy, sc1, fma(sz, sc4, sw * sc5))), -dm.y * smin);
}

void calc_superblock(const uint a_offset, const uint b_offset, const uint v_im, const uint q_offset, const uint y_offset, const uint i, const uint num_blocks_per_row, const uint first_row, const uint num_rows) {
    const uint y1_idx = i * QUANT_K + y_offset;
    const uint y2_idx = y1_idx + 128;

    // NUM_COLS is 1 for the id path
    const vec4 by10  = vec4(data_b_v4[(b_offset + y1_idx) / 4    ]);
    const vec4 by132 = vec4(data_b_v4[(b_offset + y1_idx) / 4 + 8]);
    const vec4 by20  = vec4(data_b_v4[(b_offset + y2_idx) / 4    ]);
    const vec4 by232 = vec4(data_b_v4[(b_offset + y2_idx) / 4 + 8]);

    [[unroll]] for (uint n = 0; n < num_rows; ++n) {
        const uint ib0 = a_offset + (first_row+n)*num_blocks_per_row;

        temp_g[n] += q4k_dot(FLOAT_TYPEV2(data_a[ib0 + i].dm),
                             data_a_packed16[ib0 + i].scales[v_im], data_a_packed16[ib0 + i].scales[v_im + 2], data_a_packed16[ib0 + i].scales[v_im + 4],
                             data_a_packed32[ib0 + i].qs[q_offset / 4], data_a_packed32[ib0 + i].qs[q_offset / 4 + 16],
                             by10, by132, by20, by232);
        temp_u[n] += q4k_dot(FLOAT_TYPEV2(data_a2[ib0 + i].dm),
                             data_a2_packed16[ib0 + i].scales[v_im], data_a2_packed16[ib0 + i].scales[v_im + 2], data_a2_packed16[ib0 + i].scales[v_im + 4],
                             data_a2_packed32[ib0 + i].qs[q_offset / 4], data_a2_packed32[ib0 + i].qs[q_offset / 4 + 16],
                             by10, by132, by20, by232);
    }
}

void compute_outputs(const uint32_t first_row, const uint32_t num_rows) {
    uint a_offset, b_offset, d_offset;
    get_offsets(a_offset, b_offset, d_offset);

    const uint num_blocks_per_row = p.ncols / QUANT_K;

    // 16 threads are used to process each block
    const uint it_size = gl_WorkGroupSize.x/16;
    const uint tid = gl_LocalInvocationID.x;
    const uint itid = tid%16;  // 0...15
    const uint ix = tid/16;

    const uint il = itid/4;                         // 0...3
    const uint ir = itid - 4*il;                    // 0...3
    const uint n =  4;

    const uint v_im = il / 2;
    const uint v_in = il % 2;

    const uint l0 = n * (2 * ir + v_in);            // 0...15
    const uint q_offset = 32*v_im + l0;
    const uint y_offset = 64*v_im + l0;

    [[unroll]] for (uint r = 0; r < NUM_ROWS; ++r) {
        temp_g[r] = FLOAT_TYPE(0);
        temp_u[r] = FLOAT_TYPE(0);
    }

    [[unroll]] for (uint i = ix; i < num_blocks_per_row; i += it_size)
        calc_superblock(a_offset, b_offset, v_im, q_offset, y_offset, i, num_blocks_per_row, first_row, num_rows);

    [[unroll]] for (uint r = 0; r < num_rows; ++r) {
        temp_g[r] = subgroupAdd(temp_g[r]);
        temp_u[r] = subgroupAdd(temp_u[r]);
    }

    if (tid == 0) {
        [[unroll]] for (uint r = 0; r < num_rows; ++r) {
            const float g = float(temp_g[r]);
            const float u = float(temp_u[r]);
            float o = g / (1.0f + exp(-g)) * u;
            if (expert_skip) {
                o = 0.0f;
            }
            data_d[d_offset + first_row + r] = D_TYPE(o);
        }
    }
}

void main() {
    const uint first_row = NUM_ROWS * (gl_WorkGroupID.x + gl_NumWorkGroups.x * gl_WorkGroupID.z);

    if (first_row + NUM_ROWS <= p.stride_d) {
        compute_outputs(first_row, NUM_ROWS);
    } else {
        if (first_row >= p.stride_d) {
            return;
        }
        compute_outputs(first_row, p.stride_d - first_row);
    }
}
