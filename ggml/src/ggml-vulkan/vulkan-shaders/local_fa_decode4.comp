#version 450

// local: single-token flash attention for GQA, head size 128, f16 K/V, (<= 8) query heads per kv head.
// Workgroup (x = split, y = kv head) = NW waves of 64; wave w owns query heads HG*w .. HG*w+HG-1 (as the z
// groups of local_fa_decode.comp), but the waves share each 64-key chunk: the workgroup stages the chunk's
// K rows in shared memory with contiguous loads (lane-per-key loads touch 64 cache lines per instruction and
// thrash L1 once several waves run on a CU), with the next chunk's rows loading into registers meanwhile.
// Scores: lane t owns key t of the chunk (online softmax). P*V: lane t owns 8 output dims for every fourth
// key, read as 16-byte rows; all the waves read the same V rows, so all but one hit L1.
// With more than one split, partials go to a scratch buffer and the last workgroup of a kv head (atomic
// counter) combines them, so the op stays one dispatch.

#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require
#extension GL_KHR_shader_subgroup_shuffle : require
#extension GL_EXT_control_flow_attributes : enable

#ifndef HG
#define HG 2                // query heads per wave (<= 4)
#endif
#ifndef NW
#define NW 4                // waves per workgroup, NW * HG >= G
#endif
#define NT (64 * NW)
#define KR (1024 / NT)      // K units staged per thread

layout(local_size_x = NT, local_size_y = 1, local_size_z = 1) in;

layout (push_constant) uniform parameter {
    uint KV;
    uint G;        // query heads per kv head (<= 8)
    uint nsplit;
    uint cpw;      // 64-key chunks per workgroup
    uint q_s2;     // floats between query heads
    uint k_s1;     // f16 elements between keys
    uint k_s2;     // f16 elements between kv heads
    uint v_s1;
    uint v_s2;
    uint has_mask;
    uint d_s1;     // floats between output heads
    float scale;
} p;

layout (binding = 0) readonly buffer Q { float q[]; };
layout (binding = 1) readonly buffer K { uvec4 k4[]; };
layout (binding = 2) readonly buffer V { uvec4 v4[]; };
layout (binding = 3) readonly buffer M { uint m1[]; };
layout (binding = 4) writeonly buffer D { float d[]; };
layout (binding = 5) coherent buffer S { float part[]; };
layout (binding = 5) coherent buffer SC { uint cnt[]; };
// plain view for the combine: never read before by this workgroup, so the loads come from L2
layout (binding = 5) readonly buffer SR { float partr[]; };
layout (binding = 5) readonly buffer SR4 { vec4 partr4[]; };

#define HS 128
#define PART_BASE 64        // floats reserved for counters
#define PART_STRIDE (HS + 4)   // M, L at HS, HS + 1; multiple of 4 for the vec4 reads of the combine
#define CWS (1024 / NW)     // combine weights per wave in ks
#define MAX_SPLIT (CWS < 256 ? CWS : 256)

// K chunk: key j, 16-byte unit d8 at j * 16 + (d8 ^ (j & 15)), so lane-per-key reads spread over the banks.
// Reused for the split weights of the combine.
shared uvec4 ks[64 * 16];
shared vec4 ps[NW][64];     // probabilities of key j for the wave's heads

const float NEG_INF = -1.0 / 0.0;

uint part_base(const uint hk, const uint z, const uint sp, const uint h) {
    return PART_BASE + (((hk * 8 + z) * p.nsplit + sp) * HG + h) * PART_STRIDE;
}

// this thread's KR units of the chunk's K rows, and the mask of key kb + t (issued with the K loads: vector
// loads complete in order, so a mask load issued later would make its wait cover the whole K prefetch)
void load_k(const uint kb, const uint hk, const uint tid, const uint t, out uvec4 kr[KR], out float mk) {
    mk = 0.0;
    if ((p.has_mask & 1) != 0) {
        const uint key = min(kb + t, p.KV - 1);
        const vec2 mm = unpackHalf2x16(m1[key / 2]);
        mk = (key & 1) != 0 ? mm.y : mm.x;
    }
    [[unroll]] for (uint i = 0; i < KR; i++) {
        const uint idx = tid + NT * i;
        const uint key = min(kb + idx / 16, p.KV - 1);
        kr[i] = k4[(key * p.k_s1 + hk * p.k_s2) / 8 + idx % 16];
    }
}

void main() {
    const uint tid = gl_LocalInvocationID.x;
    const uint w   = gl_SubgroupID;
    const uint t   = gl_SubgroupInvocationID;
    const uint wg  = gl_WorkGroupID.x;
    const uint hk  = gl_WorkGroupID.y;
    const uint G   = p.G;
    const uint h0  = w * HG;                // first query head (within the kv head) of this wave
    const bool has_heads = h0 < G;

    // P*V: lane t = (key group qv = t / 16, dims 8 gv .. 8 gv + 7 with gv = t % 16) takes keys qv, qv + 4, ...
    // of the chunk with 16-byte loads; the four key groups are summed once at the end
    const uint gv = t % 16;
    const uint qv = t / 16;
    float Mh[HG];
    float Lh[HG];
    vec4  Oa[HG];
    vec4  Ob[HG];
    [[unroll]] for (uint h = 0; h < HG; h++) {
        Mh[h] = NEG_INF;
        Lh[h] = 0.0;
        Oa[h] = vec4(0.0);
        Ob[h] = vec4(0.0);
    }

    const uint kv0 = wg * p.cpw * 64;
    uvec4 kr[KR];
    float mk = 0.0;
    if (kv0 < p.KV) {
        load_k(kv0, hk, tid, t, kr, mk);
    }
    const uint vbase = (hk * p.v_s2) / 8 + gv;
    const uint cpw_run = (p.has_mask & 4) != 0 ? 0 : p.cpw;   // local ablation: skip the keys
    for (uint c = 0; c < cpw_run; c++) {
        const uint kb = kv0 + c * 64;
        if (kb >= p.KV) {
            break;
        }
        barrier();                          // previous chunk's K no longer read
        [[unroll]] for (uint i = 0; i < KR; i++) {
            const uint idx = tid + NT * i;
            const uint j = idx / 16;
            ks[j * 16 + ((idx % 16) ^ (j & 15))] = kr[i];
        }
        barrier();
        const float mv = mk;
        if (c + 1 < p.cpw && kb + 64 < p.KV) {
            load_k(kb + 64, hk, tid, t, kr, mk);   // in flight during this chunk
        }
        if (!has_heads) {
            continue;
        }

        const uint key = kb + t;
        float s[HG];
        [[unroll]] for (uint h = 0; h < HG; h++) {
            s[h] = 0.0;
        }
        [[unroll]] for (uint d8 = 0; d8 < HS / 8; d8++) {
            const uvec4 kk = ks[t * 16 + (d8 ^ (t & 15))];
            const vec4 ka = vec4(unpackHalf2x16(kk.x), unpackHalf2x16(kk.y));
            const vec4 kc = vec4(unpackHalf2x16(kk.z), unpackHalf2x16(kk.w));
            [[unroll]] for (uint h = 0; h < HG; h++) {
                // uniform address: scalar loads, the products take Q from SGPRs
                const uint qb = (hk * G + min(h0 + h, G - 1)) * p.q_s2 + d8 * 8;
                s[h] += dot(vec4(q[qb], q[qb + 1], q[qb + 2], q[qb + 3]), ka) + dot(vec4(q[qb + 4], q[qb + 5], q[qb + 6], q[qb + 7]), kc);
            }
        }
        [[unroll]] for (uint h = 0; h < HG; h++) {
            s[h] *= p.scale;
        }
        if (key < p.KV) {
            [[unroll]] for (uint h = 0; h < HG; h++) {
                s[h] += mv;
            }
        } else {
            [[unroll]] for (uint h = 0; h < HG; h++) {
                s[h] = NEG_INF;
            }
        }

        float pe[HG];
        [[unroll]] for (uint h = 0; h < HG; h++) {
            const float mx = subgroupMax(s[h]);
            const float mn = max(Mh[h], mx);
            const float corr = Mh[h] == NEG_INF ? 0.0 : exp(Mh[h] - mn);
            pe[h] = s[h] == NEG_INF ? 0.0 : exp(s[h] - mn);
            Lh[h] = Lh[h] * corr + subgroupAdd(pe[h]);
            Oa[h] *= corr;
            Ob[h] *= corr;
            Mh[h] = mn;
        }
        {
            vec4 pv = vec4(0.0);
            [[unroll]] for (uint h = 0; h < HG; h++) {
                pv[h] = pe[h];
            }
            ps[w][t] = pv;
        }
        subgroupMemoryBarrierShared();
        subgroupBarrier();

        // keys past KV have p = 0 (clamped index)
        uvec4 vr[16];
        if (kb + 64 <= p.KV) {
            // full chunk: per-lane base plus a uniform step, no per-key clamp and multiply
            const uint va0 = ((kb + qv) * p.v_s1) / 8 + vbase;
            const uint vstep = p.v_s1 / 2;  // 4 keys, in uvec4
            [[unroll]] for (uint i = 0; i < 16; i++) {
                vr[i] = v4[va0 + i * vstep];
            }
        } else {
            [[unroll]] for (uint i = 0; i < 16; i++) {
                const uint kj = min(kb + 4 * i + qv, p.KV - 1);
                vr[i] = v4[(kj * p.v_s1) / 8 + vbase];
            }
        }
        [[unroll]] for (uint i = 0; i < 16; i++) {
            const vec4 pj = ps[w][4 * i + qv];
            const vec4 va = vec4(unpackHalf2x16(vr[i].x), unpackHalf2x16(vr[i].y));
            const vec4 vb = vec4(unpackHalf2x16(vr[i].z), unpackHalf2x16(vr[i].w));
            [[unroll]] for (uint h = 0; h < HG; h++) {
                Oa[h] += pj[h] * va;
                Ob[h] += pj[h] * vb;
            }
        }
        subgroupMemoryBarrierShared();
        subgroupBarrier();
    }

    // sum the four key groups: lanes gv, gv + 16, gv + 32, gv + 48
    [[unroll]] for (uint h = 0; h < HG; h++) {
        Oa[h] += subgroupShuffleXor(Oa[h], 16);
        Ob[h] += subgroupShuffleXor(Ob[h], 16);
        Oa[h] += subgroupShuffleXor(Oa[h], 32);
        Ob[h] += subgroupShuffleXor(Ob[h], 32);
    }

    const uint ng = has_heads ? min(HG, G - h0) : 0;
    if (p.nsplit == 1) {
        [[unroll]] for (uint h = 0; h < HG; h++) {
            if (h < ng && qv == 0) {
                const vec4 oa = Oa[h] / Lh[h];
                const vec4 ob = Ob[h] / Lh[h];
                const uint db = (hk * G + h0 + h) * p.d_s1 + 8 * gv;
                d[db]     = oa.x; d[db + 1] = oa.y; d[db + 2] = oa.z; d[db + 3] = oa.w;
                d[db + 4] = ob.x; d[db + 5] = ob.y; d[db + 6] = ob.z; d[db + 7] = ob.w;
            }
        }
        return;
    }

    if (has_heads) {
        [[unroll]] for (uint h = 0; h < HG; h++) {
            const uint pb = part_base(hk, w, wg, h);
            if (qv == 0) {
                const uint ob = pb + 8 * gv;
                part[ob]     = Oa[h].x; part[ob + 1] = Oa[h].y; part[ob + 2] = Oa[h].z; part[ob + 3] = Oa[h].w;
                part[ob + 4] = Ob[h].x; part[ob + 5] = Ob[h].y; part[ob + 6] = Ob[h].z; part[ob + 7] = Ob[h].w;
            }
            if (t == 0) {
                part[pb + HS]     = Mh[h];
                part[pb + HS + 1] = Lh[h];
            }
        }
    }
    if ((p.has_mask & 2) != 0) {
        return;                             // local ablation: no combine
    }
    memoryBarrierBuffer();
    barrier();
    if (tid == 0) {
        const uint old = atomicAdd(cnt[hk * 8], 1u);
        ks[0].x = old == p.nsplit - 1 ? 1u : 0u;
    }
    barrier();
    if (ks[0].x == 0) {
        return;
    }
    barrier();
    memoryBarrierBuffer();
    if (!has_heads) {
        return;
    }

    // The combine is a chain of dependent L2 round trips, so the loads are batched: (1) lane t loads max and
    // sum of splits t, t+64, ... (nsplit <= MAX_SPLIT) for all the wave's heads at once, and the weights
    // exp(m_s - M) / L go to ks (wave w: ks[w * 256 + split], component h = head h)
    {
        float mr[HG][MAX_SPLIT / 64];
        float lr[HG][MAX_SPLIT / 64];
        [[unroll]] for (uint r = 0; r < MAX_SPLIT / 64; r++) {
            const uint sp = min(t + 64 * r, p.nsplit - 1);   // clamped: unconditional loads issue together
            [[unroll]] for (uint h = 0; h < HG; h++) {
                const uint pb = part_base(hk, w, sp, h);
                mr[h][r] = partr[pb + HS];
                lr[h][r] = partr[pb + HS + 1];
            }
        }
        [[unroll]] for (uint h = 0; h < HG; h++) {
            float ml = NEG_INF;
            [[unroll]] for (uint r = 0; r < MAX_SPLIT / 64; r++) {
                ml = max(ml, mr[h][r]);
            }
            const float mx = subgroupMax(ml);
            float ll = 0.0;
            [[unroll]] for (uint r = 0; r < MAX_SPLIT / 64; r++) {
                const bool ok = t + 64 * r < p.nsplit && mr[h][r] != NEG_INF;
                mr[h][r] = ok ? exp(mr[h][r] - mx) : 0.0;
                ll += mr[h][r] * lr[h][r];
            }
            const float ls = subgroupAdd(ll);
            // zero past nsplit, so the sum below needs no bounds test (with one, the compiler sinks each
            // split's loads into its branch and waits for them one split at a time)
            [[unroll]] for (uint r = 0; r < MAX_SPLIT / 64; r++) {
                ks[w * CWS + t + 64 * r][h] = floatBitsToUint(mr[h][r] / ls);
            }
        }
    }
    subgroupMemoryBarrierShared();
    subgroupBarrier();
    // 2) lane t = (split parity sg = t / 32, dims 4 d4 .. 4 d4 + 3 with d4 = t % 32) sums its splits with 16-byte
    // loads, CB2 per lane in flight (GFX8 keeps at most 15 vector loads outstanding); the halves are added at the end
    const uint sg = t / 32;
    const uint d4 = t % 32;
    vec4 Oc[HG];
    [[unroll]] for (uint h = 0; h < HG; h++) {
        Oc[h] = vec4(0.0);
    }
#define CB2 (16 / HG)
    for (uint sp0 = 0; sp0 < p.nsplit; sp0 += 2 * CB2) {
        vec4 ov[CB2][HG];
        [[unroll]] for (uint u = 0; u < CB2; u++) {
            const uint sp = min(sp0 + 2 * u + sg, p.nsplit - 1);
            [[unroll]] for (uint h = 0; h < HG; h++) {
                ov[u][h] = partr4[part_base(hk, w, sp, h) / 4 + d4];
            }
        }
        [[unroll]] for (uint u = 0; u < CB2; u++) {
            const uvec4 wb = ks[w * CWS + sp0 + 2 * u + sg];   // nsplit <= MAX_SPLIT - 2 * CB2: stays in this wave's CWS
            [[unroll]] for (uint h = 0; h < HG; h++) {
                Oc[h] += uintBitsToFloat(wb[h]) * ov[u][h];
            }
        }
    }
    [[unroll]] for (uint h = 0; h < HG; h++) {
        Oc[h] += subgroupShuffleXor(Oc[h], 32);
        if (h < ng && sg == 0) {
            const uint db = (hk * G + h0 + h) * p.d_s1 + 4 * d4;
            d[db]     = Oc[h].x;
            d[db + 1] = Oc[h].y;
            d[db + 2] = Oc[h].z;
            d[db + 3] = Oc[h].w;
        }
    }
    if (tid == 0) {
        cnt[hk * 8] = 0u;
    }
}
