#version 450

// local: wait until every peer flag page holds the round number.
// GCN3 L2 keeps stale copies of host memory: thread 0 polls lines not read before in this round,
// and after a full pass the workgroup sweeps a scratch buffer to evict them. Bounded, never hangs.

#extension GL_EXT_shader_realtime_clock : require
#extension GL_EXT_control_flow_attributes : enable

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout (push_constant) uniform parameter {
    uint round;
    uint n;
    uint limit;  // max realtime clock ticks for the whole wait
    uint stride; // words between polled lines
    uint lines;  // distinct lines in a flag page
    uint sweep;  // vec4 elements in the scratch buffer
} p;

layout (binding = 0) coherent volatile buffer F0 { uint f0[]; };
layout (binding = 1) coherent volatile buffer F1 { uint f1[]; };
layout (binding = 2) coherent volatile buffer F2 { uint f2[]; };
layout (binding = 3) coherent volatile buffer F3 { uint f3[]; };
layout (binding = 4) coherent volatile buffer F4 { uint f4[]; };
layout (binding = 5) coherent volatile buffer F5 { uint f5[]; };
layout (binding = 6) coherent volatile buffer F6 { uint f6[]; };
layout (binding = 7) coherent volatile buffer F7 { uint f7[]; };
layout (binding = 8) coherent buffer S { uvec4 scratch[]; };

shared uint sh_done;

uint load_flag(uint k, uint i) {
    switch (k) {
    case 0: return f0[i];
    case 1: return f1[i];
    case 2: return f2[i];
    case 3: return f3[i];
    case 4: return f4[i];
    case 5: return f5[i];
    case 6: return f6[i];
    default: return f7[i];
    }
}

void main() {
    const uint tid = gl_LocalInvocationID.x;
    uint polls = 0;
    uint sweeps = 0;
    const uint t0 = clockRealtime2x32EXT().x;
    // a timed out wait is sticky: later waits skip at once, the host sees f7[8] and aborts
    const bool dead = f7[8] != 0;
    // thread 0 reads line l of every peer per step, the loads in flight together (one peer after the other
    // made each wait a chain of PCIe round trips, ~13 per wait in decode); peers already seen stay seen
    const uint all = (1u << p.n) - 1u;
    uint got = 0;
    while (!dead) {
        if (tid == 0) {
            uint done = 0;
            for (uint l = 0; l < p.lines && got != all; l++) {
                uint v[7];
                [[unroll]] for (uint k = 0; k < 7; k++) {
                    v[k] = load_flag(k, l * p.stride);   // bindings past p.n repeat peer 0
                }
                polls++;
                [[unroll]] for (uint k = 0; k < 7; k++) {
                    if (k < p.n && int(v[k] - p.round) >= 0) {
                        got |= 1u << k;
                    }
                }
            }
            if (got == all) {
                done = 1;
            } else if (clockRealtime2x32EXT().x - t0 >= p.limit) {
                f7[8] = f7[8] + 1;
                f7[9] = clockRealtime2x32EXT().x - t0;
                f7[10] = p.round;
                f7[11] = findLSB(~got);
                f7[12] = polls;
                f7[13] = sweeps;
                done = 2;
            }
            sh_done = done;
        }
        barrier();
        const bool done = sh_done != 0;
        barrier();
        if (done) {
            break;
        }
        // evict: every thread streams its part of the scratch buffer
        uvec4 acc = uvec4(0);
        for (uint i = tid; i < p.sweep; i += 256) {
            acc ^= scratch[i];
        }
        if (acc.x == 0x9e3779b9u && acc.y == p.round) {
            scratch[0].w = acc.z; // practically never, keeps the loads alive
        }
        sweeps++;
    }
    if (tid == 0 && p.n < 8) {
        // debug words in binding 7: [0] polls, [1] sweeps, [16] round
        f7[0] = polls;
        f7[1] = sweeps;
        f7[2] = f7[2] + sweeps;
        f7[3] = f7[3] + 1;
        f7[4] = f7[4] + polls;
        f7[5] = f7[5] + (clockRealtime2x32EXT().x - t0);
        f7[16] = p.round;
    }
}
